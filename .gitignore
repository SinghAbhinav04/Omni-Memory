# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Secrets / environment (never commit) ────────────────────────────────
.env
.env.*
*.pem
*.key
credentials.json
.omni-memory/credentials.json

# ── OmniMemory runtime store (per-project, machine-local) ───────────────
.omni-memory/
*.db
*.sqlite
*.sqlite3

# ── Node / web dashboard build output ───────────────────────────────────
node_modules/
web/dist/
web/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Claude Code local config (machine-specific absolute paths) ──────────
# `omni-memory install` writes .claude/settings.json with this machine's
# python + repo path — regenerated per-machine, so keep it out of the repo.
.claude/settings.json
.claude/settings.local.json
.claude/*.bak-*

# ── Editors / OS cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs ────────────────────────────────────────────────────────────────
*.log
